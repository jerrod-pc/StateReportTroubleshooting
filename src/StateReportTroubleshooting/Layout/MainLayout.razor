@inherits LayoutComponentBase
@inject TroubleshootingDataService Data

<nav class="navbar navbar-expand-md navbar-dark bg-dark app-navbar px-3">
    <div class="container-fluid gap-3">
        <a class="navbar-brand" href="">State Report Troubleshooting</a>
        <NavMenu />
        @if (Data.IsInitialized)
        {
            <div class="ms-md-auto" style="min-width: 280px; max-width: 420px; width: 100%;">
                <QuickJumpBox />
            </div>
        }
        <ThemeToggle />
    </div>
</nav>

<main class="container-fluid py-4">
    @if (!Data.IsInitialized)
    {
        <LoadingSplash />
    }
    else
    {
        @Body
    }
</main>

@code {
    protected override async Task OnInitializedAsync()
    {
        await Data.InitializeAsync();
    }
}
