@if (Result.Items.Count <= 1)
{
    <span style="white-space: pre-wrap;">@Text</span>
}
else
{
    <div class="formatted-text-list">
        @foreach (var item in Result.Items)
        {
            <div class="formatted-text-item @(Result.IsList ? "formatted-text-item-list" : "formatted-text-item-paragraph")">@item</div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public string? Text { get; set; }

    private TextFormat.FormattedItems Result => TextFormat.SplitIntoItems(Text);
}
