@page "/resources"

<PageTitle>Resources - State Report Troubleshooting</PageTitle>

<h1 class="mb-3">Resources</h1>

<h4 class="mb-2">Quick Links</h4>
<div class="list-group mb-4">
    @foreach (var link in QuickLinks)
    {
        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
           href="@link.Url" target="_blank" rel="noopener noreferrer">
            <span>@link.Label</span>
            <span class="text-muted small">Open ↗</span>
        </a>
    }
</div>

<h4 class="mb-2">Downloads</h4>
<p class="text-muted">
    The original DESE handbooks, error lists, and appendix workbooks this app's data was built from.
</p>

@foreach (var group in DownloadGroups)
{
    <h6 class="mt-3">@group.Title</h6>
    <div class="list-group mb-3">
        @foreach (var file in group.Files)
        {
            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
               href="@("resources/" + file.FileName)" download>
                <span>@file.Label</span>
                <span class="badge text-bg-secondary">@file.Extension</span>
            </a>
        }
    </div>
}

@code {
    private record LinkItem(string Label, string Url);

    private record FileItem(string Label, string FileName)
    {
        public string Extension => System.IO.Path.GetExtension(FileName).TrimStart('.').ToUpperInvariant();
    }

    private record FileGroup(string Title, List<FileItem> Files);

    private static readonly List<LinkItem> QuickLinks =
    [
        new("State Login (EdWin/Stardust Gateway)", "https://gateway.edu.state.ma.us/stardust/login"),
        new("DESE Data Collection Documentation", "https://www.doe.mass.edu/infoservices/data/default.html"),
        new("EOE Support Request Form", "https://massgov.service-now.com/eoe?id=eoe_req_form&sys_id=87451de4dbba47006152f25bbf961923"),
        new("Rediker Software State Reporting Solutions", "https://support.rediker.com/en/support/solutions/14000072051"),
    ];

    private static readonly List<FileGroup> DownloadGroups =
    [
        new("SCS", [
            new("SCS Data Handbook", "scs-datahandbook.pdf"),
            new("SCS Error List", "scs-errorlist.pdf"),
        ]),
        new("EPIMS", [
            new("EPIMS Data Handbook", "epims-datahandbook.pdf"),
            new("EPIMS Error List", "epims-errorlist.pdf"),
            new("EPIMS Appendices", "epims-appendices.xlsx"),
        ]),
        new("SIMS", [
            new("SIMS Data Handbook", "sims-datahandbook.pdf"),
            new("SIMS Error List", "sims-errorlist.pdf"),
            new("SIMS Appendices", "sims-appendices.xlsx"),
        ]),
        new("SSDR", [
            new("SSDR Data Handbook", "ssdr-datahandbook.pdf"),
            new("SSDR Error List", "ssdr-errorlist.pdf"),
        ]),
        new("General", [
            new("School & District Profiles Workbook", "stateprofile.xlsx"),
            new("Technical Guide", "technical-guide.pdf"),
        ]),
    ];
}
