@page "/objects/{Name}"
@inject TroubleshootingDataService Data

<PageTitle>@(_object?.Name ?? Name) - SIF Objects</PageTitle>

@if (_object is null)
{
    <p class="text-danger">SIF object <strong>@Name</strong> not found.</p>
    <a href="/objects">&larr; Back to SIF Objects</a>
}
else
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/objects">SIF Objects</a></li>
            <li class="breadcrumb-item active">@_object.Name</li>
        </ol>
    </nav>

    <h1 class="mb-1">
        @_object.Name
        @if (!string.IsNullOrWhiteSpace(_object.Abbreviation))
        {
            <span class="text-muted fs-5">(@_object.Abbreviation)</span>
        }
    </h1>

    <p class="mb-2">
        <span class="badge text-bg-secondary me-2">Level @_object.Level</span>
        @if (_object.UsedIn.Count == 0)
        {
            <span class="text-muted small">General use &mdash; not tied to a specific collection</span>
        }
        else
        {
            @foreach (var c in _object.UsedIn)
            {
                <a class="badge text-bg-info text-decoration-none me-1" href="@($"/collection/{c}")">@c</a>
            }
        }
    </p>

    @if (!string.IsNullOrWhiteSpace(_object.Purpose))
    {
        <p class="mb-4">@_object.Purpose</p>
    }

    <h5 class="mb-2">Elements</h5>
    @if (_object.Elements.Count == 0)
    {
        <p class="text-muted fst-italic">No MA-relevant elements identified for this object.</p>
    }
    else
    {
        <div class="list-group mb-4">
            @foreach (var el in _object.Elements)
            {
                <div class="list-group-item">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-1">
                        <code class="fw-semibold">@el.Path</code>
                        <span>
                            @foreach (var c in el.UsedIn)
                            {
                                var fields = el.Fields.Where(f => f.Collection == c).ToList();
                                if (fields.Count > 0)
                                {
                                    @foreach (var f in fields)
                                    {
                                        <a class="badge text-bg-primary text-decoration-none ms-1"
                                           href="@($"/collection/{c}/fields/{Uri.EscapeDataString(f.FieldId)}")"
                                           title="@c">@f.FieldId</a>
                                    }
                                }
                                else if (el.Requirement.TryGetValue(c, out var flag))
                                {
                                    <span class="badge text-bg-secondary ms-1" title="@RequirementLabel(flag)">@c</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary ms-1">@c</span>
                                }
                            }
                        </span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(el.Description))
                    {
                        <p class="small text-muted mb-0 mt-1">@el.Description</p>
                    }
                </div>
            }
        </div>
    }

    @if (_object.Notes.Count > 0)
    {
        <h6 class="mb-2 text-muted">Advanced implementation notes</h6>
        <div class="accordion mb-3" id="objectNotesAccordion">
            @for (var i = 0; i < _object.Notes.Count; i++)
            {
                var note = _object.Notes[i];
                var headingId = $"objNoteHeading{i}";
                var collapseId = $"objNoteCollapse{i}";
                <div class="accordion-item">
                    <h2 class="accordion-header" id="@headingId">
                        <button class="accordion-button collapsed" type="button"
                                data-bs-toggle="collapse" data-bs-target="@("#" + collapseId)"
                                aria-expanded="false" aria-controls="@collapseId">
                            @(note.Heading ?? _object.Name)
                        </button>
                    </h2>
                    <div id="@collapseId" class="accordion-collapse collapse"
                         aria-labelledby="@headingId" data-bs-parent="#objectNotesAccordion">
                        <div class="accordion-body">
                            <FormattedText Text="@note.Body" />
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    [Parameter] public string Name { get; set; } = "";

    private SifObject? _object;

    protected override void OnParametersSet()
    {
        _object = Data.FindSifObject(Name);
    }

    private static string RequirementLabel(string flag) => flag switch
    {
        "M" => "Mandatory",
        "MR" => "Mandatory, repeating",
        "C" => "Conditional",
        "O" => "Optional",
        _ => flag,
    };
}
