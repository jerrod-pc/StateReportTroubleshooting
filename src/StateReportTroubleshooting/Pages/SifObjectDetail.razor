@page "/objects/{Name}"
@inject TroubleshootingDataService Data

<PageTitle>@(_object?.Name ?? Name) - SIF Objects</PageTitle>

@if (_object is null)
{
    <p class="text-danger">SIF object <strong>@Name</strong> not found.</p>
    <a href="/objects">&larr; Back to SIF Objects</a>
}
else
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/objects">SIF Objects</a></li>
            <li class="breadcrumb-item active">@_object.Name</li>
        </ol>
    </nav>

    <h1 class="mb-1">
        @_object.Name
        @if (!string.IsNullOrWhiteSpace(_object.Abbreviation))
        {
            <span class="text-muted fs-5">(@_object.Abbreviation)</span>
        }
    </h1>

    <p class="mb-3">
        <span class="badge text-bg-secondary me-2">Level @_object.Level</span>
        @if (_object.UsedIn.Count == 0)
        {
            <span class="text-muted small">General use &mdash; not tied to a specific collection</span>
        }
        else
        {
            @foreach (var c in _object.UsedIn)
            {
                <a class="badge text-bg-info text-decoration-none me-1" href="@($"/collection/{c}")">@c</a>
            }
        }
    </p>

    <h5 class="mb-2 mt-4">Implementation notes</h5>
    @if (_object.Notes.Count == 0)
    {
        <p class="text-muted fst-italic">No special instructions identified for this object.</p>
    }
    else if (_object.Notes.Count == 1)
    {
        <FormattedText Text="@_object.Notes[0].Body" />
    }
    else
    {
        <div class="accordion mb-3" id="objectNotesAccordion">
            @for (var i = 0; i < _object.Notes.Count; i++)
            {
                var note = _object.Notes[i];
                var isFirst = i == 0;
                var headingId = $"objNoteHeading{i}";
                var collapseId = $"objNoteCollapse{i}";
                <div class="accordion-item">
                    <h2 class="accordion-header" id="@headingId">
                        <button class="accordion-button @(isFirst ? "" : "collapsed")" type="button"
                                data-bs-toggle="collapse" data-bs-target="@("#" + collapseId)"
                                aria-expanded="@(isFirst ? "true" : "false")" aria-controls="@collapseId">
                            @(note.Heading ?? _object.Name)
                        </button>
                    </h2>
                    <div id="@collapseId" class="accordion-collapse collapse @(isFirst ? "show" : "")"
                         aria-labelledby="@headingId" data-bs-parent="#objectNotesAccordion">
                        <div class="accordion-body">
                            <FormattedText Text="@note.Body" />
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <h5 class="mb-2 mt-4">Fields already modeled for this object</h5>
    @if (LinkedFields.Count == 0)
    {
        <p class="text-muted fst-italic">None of the currently modeled fields map directly to this object.</p>
    }
    else
    {
        <ul class="list-group">
            @foreach (var (collection, field) in LinkedFields)
            {
                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                   href="@($"/collection/{collection}/fields/{Uri.EscapeDataString(field.FieldId!)}")">
                    <span><strong>@field.FieldId</strong> &mdash; @field.Name</span>
                    <span class="badge text-bg-secondary rounded-pill">@collection</span>
                </a>
            }
        </ul>
    }
}

@code {
    [Parameter] public string Name { get; set; } = "";

    private SifObject? _object;

    protected override void OnParametersSet()
    {
        _object = Data.FindSifObject(Name);
    }

    private List<(string Collection, FieldEntry Field)> LinkedFields =>
        _object is null ? [] : Data.FieldsForSifObject(_object.Name);
}
