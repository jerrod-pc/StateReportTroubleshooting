@page "/"
@inject TroubleshootingDataService Data

<PageTitle>State Report Troubleshooting</PageTitle>

<h1 class="mb-3">State Report Troubleshooting</h1>
<p class="text-muted">
    Pick a collection, or jump straight to an error code (e.g. <code>EPIMS6420</code>) using the box above.
</p>

<div class="row row-cols-1 row-cols-md-2 g-3 mt-2">
    @foreach (var name in TroubleshootingDataService.CollectionNames)
    {
        if (Data.Collections.TryGetValue(name, out var file))
        {
            <div class="col">
                <a class="card text-decoration-none h-100" href="@($"/collection/{name}")">
                    <div class="card-body">
                        <h5 class="card-title">@name</h5>
                        <p class="card-text text-muted mb-1">
                            Error list v@(file.ErrorListVersion) &middot; Handbook v@(file.HandbookVersion)
                        </p>
                        <p class="card-text">
                            <span class="badge text-bg-secondary me-1">@file.Errors.Count errors</span>
                            <span class="badge text-bg-secondary">@file.Fields.Count fields</span>
                        </p>
                    </div>
                </a>
            </div>
        }
    }
</div>
