@page "/objects"
@inject TroubleshootingDataService Data

<PageTitle>SIF Objects - State Report Troubleshooting</PageTitle>

<h1 class="mb-2">SIF Objects</h1>
<p class="text-muted mb-4">
    SIF (Schools Interoperability Framework) is the data-exchange standard your SIS uses to transmit state
    reports. Every field in the four collections maps to an element inside one of these objects &mdash; this
    is a reference to what each object is, which collections use it, and any implementation notes DESE has
    published for it. Browse by level below, or jump here directly from any field's SIF mapping.
</p>

@if (Data.SifGeneralNotes.Count > 0)
{
    <h5 class="mb-2">General reporting notes</h5>
    <p class="text-muted small">Guidance that spans multiple objects rather than belonging to just one.</p>
    <div class="accordion mb-4" id="generalNotesAccordion">
        @for (var i = 0; i < Data.SifGeneralNotes.Count; i++)
        {
            var note = Data.SifGeneralNotes[i];
            var headingId = $"genNoteHeading{i}";
            var collapseId = $"genNoteCollapse{i}";
            <div class="accordion-item">
                <h2 class="accordion-header" id="@headingId">
                    <button class="accordion-button collapsed" type="button"
                            data-bs-toggle="collapse" data-bs-target="@("#" + collapseId)"
                            aria-expanded="false" aria-controls="@collapseId">
                        @note.Heading
                    </button>
                </h2>
                <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headingId"
                     data-bs-parent="#generalNotesAccordion">
                    <div class="accordion-body">
                        <FormattedText Text="@note.Body" />
                    </div>
                </div>
            </div>
        }
    </div>
}

@foreach (var level in Levels)
{
    var objects = Data.SifObjects.Where(o => o.Level == level).ToList();
    if (objects.Count == 0) continue;

    <h5 class="mb-2 mt-3">Level @level</h5>
    <div class="list-group mb-3">
        @foreach (var obj in objects)
        {
            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
               href="@($"/objects/{Uri.EscapeDataString(obj.Name)}")">
                <span>
                    <strong>@obj.Name</strong>
                    @if (!string.IsNullOrWhiteSpace(obj.Abbreviation))
                    {
                        <span class="text-muted">(@obj.Abbreviation)</span>
                    }
                </span>
                <span>
                    @if (obj.UsedIn.Count == 0)
                    {
                        <span class="text-muted small">General use</span>
                    }
                    else
                    {
                        @foreach (var c in obj.UsedIn)
                        {
                            <span class="badge text-bg-secondary ms-1">@c</span>
                        }
                    }
                </span>
            </a>
        }
    </div>
}

@code {
    private static readonly string[] Levels = ["I", "II", "III", "IV", "V"];
}
